import sysl.text.parse_int

// Solves Sudoku puzzles by upstream C's algorithm (sudoku.c, Attractive Chaos, MIT), an improved
// form of Guenter Stertenbrink's suexco.c.
//
// There are 9x9x9 = 729 choices (a number for a cell) and 4x9x9 = 324 constraints (each cell holds
// one number; each number appears once in a box, once in a row and once in a column). The 729x324
// binary matrix relating them is kept sparse: each choice is in 4 constraints and each constraint
// holds 9 choices. The solver keeps, per choice, how many chosen constraints forbid it, and per
// constraint, how many choices it still allows, and backtracks over the constraint with the fewest.

// The sparse matrix: choice r[c][i] is in constraint c, and choice r is in constraint c[r][j].
struct Aux
    r: [324][9]u16
    c: [729][4]u16

sd_genmat() -> &Aux
    val a: &Aux = Aux([[0; 9]; 324], [[0; 4]; 729])
    var nr: [324]i8 = [0; 324]
    var r = 0

    for i in 0..<9
        for j in 0..<9
            for k in 0..<9
                a.c[r][0] = u16(9 * i + j)
                a.c[r][1] = u16((i / 3 * 3 + j / 3) * 9 + k + 81)
                a.c[r][2] = u16(9 * i + k + 162)
                a.c[r][3] = u16(9 * j + k + 243)
                r += 1

    for r in 0..<729
        for c2 in 0..<4
            val k = a.c[r][c2]
            a.r[k][nr[k]++] = u16(r)

    return a

// Takes choice r: uses up its four constraints and forbids every other choice in them. Answers the
// smallest count of allowed choices met on the way, shifted up 16, or'd with its constraint.
sd_update_for(aux: &Aux, sr: []i8, sc: []u8, r: int) -> int
    var min = 10
    var min_c = 0

    for c2 in 0..<4 do sc[aux.c[r][c2]] |= 0x80

    for c2 in 0..<4
        val c = aux.c[r][c2]

        for r2 in 0..<9
            val rr = aux.r[c][r2]

            if sr[rr]++ != 0 then continue

            for cc2 in 0..<4
                val cc = int(aux.c[rr][cc2])

                if int(--sc[cc]) < min
                    min = int(sc[cc])
                    min_c = cc

    return min << 16 | min_c

// Takes choice r back: the inverse of sd_update_for.
sd_update_rev(aux: &Aux, sr: []i8, sc: []u8, r: int)
    for c2 in 0..<4 do sc[aux.c[r][c2]] &= 0x7f

    for c2 in 0..<4
        val c = aux.c[r][c2]

        for r2 in 0..<9
            val rr = aux.r[c][r2]

            if --sr[rr] != 0 then continue

            val p = aux.c[rr]
            sc[p[0]] += 1
            sc[p[1]] += 1
            sc[p[2]] += 1
            sc[p[3]] += 1

// Prints every solution of the puzzle s (81 bytes, '1'..'9' for a hint and anything else for a
// blank), one line each, and answers how many there were.
sd_solve(aux: &Aux, s: string) -> int
    // sr[r]: how many chosen constraints forbid choice r. sc[c]: bits 0-6 the choices constraint c
    // still allows, bit 7 whether it is used. cr[i] and cc[i]: the choice and constraint of step i.
    var sr: [729]i8 = [0; 729]
    var sc: [324]u8 = [9; 324]
    var cr: [81]i8 = [-1; 81]
    var cc: [81]i16 = [-1; 81]
    var out: [82]u8 = [0; 82]
    var n = 0
    var hints = 0

    for i in 0..<81
        val ch = s.bytes[i]

        if ch >= u8('1') && ch <= u8('9')
            sd_update_for(aux, sr, sc, i * 9 + int(ch - u8('1')))
            hints += 1

        out[i] = ch

    out[81] = u8('\n')

    // dir is 1 going forward and -1 backtracking.
    var dir = 1
    var cand = 10 << 16 | 0
    var i = 0

    loop
        while i >= 0 && i < 81 - hints
            if dir == 1
                var min = cand >> 16
                cc[i] = i16(cand & 0xffff)

                if min > 1
                    for c in 0..<324
                        if int(sc[c]) < min
                            min = int(sc[c])
                            cc[i] = i16(c)

                            if min <= 1 then break

                if min == 0 || min == 10
                    dir = -1
                    cr[i--] = -1

            val c = cc[i]

            if dir == -1 && cr[i] >= 0 then sd_update_rev(aux, sr, sc, int(aux.r[c][cr[i]]))

            var r2 = int(cr[i]) + 1

            while r2 < 9 && sr[aux.r[c][r2]] != 0 do r2 += 1

            if r2 < 9
                cand = sd_update_for(aux, sr, sc, int(aux.r[c][r2]))
                cr[i++] = i8(r2)
                dir = 1
            else
                dir = -1
                cr[i--] = -1

        if i < 0 then break

        for j in 0..<i
            val r = aux.r[cc[j]][cr[j]]
            out[r / 9] = u8(r % 9) + u8('1')

        putbytes(out)
        n += 1
        i -= 1
        dir = -1

    return n

val HARD20 = [
    "..............3.85..1.2.......5.7.....4...1...9.......5......73..2.1........4...9",
    ".......12........3..23..4....18....5.6..7.8.......9.....85.....9...4.5..47...6...",
    ".2..5.7..4..1....68....3...2....8..3.4..2.5.....6...1...2.9.....9......57.4...9..",
    "........3..1..56...9..4..7......9.5.7.......8.5.4.2....8..2..9...35..1..6........",
    "12.3....435....1....4........54..2..6...7.........8.9...31..5.......9.7.....6...8",
    "1.......2.9.4...5...6...7...5.9.3.......7.......85..4.7.....6...3...9.8...2.....1",
    ".......39.....1..5..3.5.8....8.9...6.7...2...1..4.......9.8..5..2....6..4..7.....",
    "12.3.....4.....3....3.5......42..5......8...9.6...5.7...15..2......9..6......7..8",
    "..3..6.8....1..2......7...4..9..8.6..3..4...1.7.2.....3....5.....5...6..98.....5.",
    "1.......9..67...2..8....4......75.3...5..2....6.3......9....8..6...4...1..25...6.",
    "..9...4...7.3...2.8...6...71..8....6....1..7.....56...3....5..1.4.....9...2...7..",
    "....9..5..1.....3...23..7....45...7.8.....2.......64...9..1.....8..6......54....7",
    "4...3.......6..8..........1....5..9..8....6...7.2........1.27..5.3....4.9........",
    "7.8...3.....2.1...5.........4.....263...8.......1...9..9.6....4....7.5...........",
    "3.7.4...........918........4.....7.....16.......25..........38..9....5...2.6.....",
    "........8..3...4...9..2..6.....79.......612...6.5.2.7...8...5...1.....2.4.5.....3",
    ".......1.4.........2...........5.4.7..8...3....1.9....3..4..2...5.1........8.6...",
    ".......12....35......6...7.7.....3.....4..8..1...........12.....8.....4..5....6..",
    "1.......2.9.4...5...6...7...5.3.4.......6........58.4...2...6...3...9.8.7.......1",
    ".....1.2.3...4.5.....6....7..2.....1.8..9..3.4.....8..5....2....9..3.4....67.....",
]

main(args: []string)
    val n = if args.len > 1 then parse_int(args[1]).unwrap() else 200
    val a = sd_genmat()

    for _ in 0..<n
        for s in HARD20
            sd_solve(a, s)
            putbytes("\n".bytes)
