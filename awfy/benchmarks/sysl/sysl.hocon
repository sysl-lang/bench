// The Are We Fast Yet benchmarks in sysl: the harness (harness.sysl, run.sysl, benchmark.sysl), the
// benchmarks, and the suite's own collections in `som/`. Built by awfy/reproduce.zsh. sysl 0.12.0 is
// the first release with `@no_fuse`, which every file starts with.
package { name = "awfy", version = "0.1.0", sysl = "0.12.0" }

requires {
  heap = true
}
