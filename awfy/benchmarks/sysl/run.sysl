@no_fuse

import sysl.time.{monotonic, whole_micros}

// Runs one benchmark num_iterations times, timing each run of its inner loop.
struct Run
    name: string
    num_iterations: int
    inner_iterations: int
    total: long

    run_benchmark(*self)
        print(f"Starting ${self.name} benchmark ...")

        self.name match
            "Bounce" -> self.do_runs(Bounce())
            "CD" -> self.do_runs(CD())
            "DeltaBlue" -> self.do_runs(DeltaBlue())
            "Havlak" -> self.do_runs(Havlak())
            "Json" -> self.do_runs(Json())
            "List" -> self.do_runs(List())
            "Mandelbrot" -> self.do_runs(Mandelbrot())
            "NBody" -> self.do_runs(NBody())
            "Permute" -> self.do_runs(Permute(0, []))
            "Queens" -> self.do_runs(Queens([], [], [], []))
            "Richards" -> self.do_runs(Richards())
            "Sieve" -> self.do_runs(Sieve())
            "Storage" -> self.do_runs(Storage(0))
            "Towers" -> self.do_runs(Towers([None, None, None], 0))
            _ ->
                eprints(f"Benchmark not recognized: ${self.name}\n")
                exit(1)

        self.report_benchmark()
        print("")

    print_total(*self) = print(f"Total Runtime: ${self.total}us")

    private do_runs[B: Benchmark](*self, bench: B)
        var b = bench
        for _ in 0..<self.num_iterations do self.measure(&b)

    private measure[B: Benchmark](*self, bench: *B)
        val start_time = monotonic()

        if !bench.inner_benchmark_loop(self.inner_iterations)
            print("Benchmark failed with incorrect result")
            exit(1)

        val run_time = whole_micros(monotonic() - start_time)

        self.print_result(run_time)
        self.total += run_time

    private report_benchmark(*self)
        print(f"${self.name}: iterations=${self.num_iterations} average: ${self.total / self.num_iterations}us total: ${self.total}us")

    private print_result(*self, run_time: long) = print(f"${self.name}: iterations=1 runtime: ${run_time}us")
end Run
