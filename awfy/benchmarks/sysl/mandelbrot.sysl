@no_fuse

struct Mandelbrot
    // C++ and Java overload verify_result; sysl refuses a member of a type colliding with a trait
    // member, so this one is named for its benchmark.
    private verify_mandelbrot(*self, result: int, inner_iterations: int) -> bool
        if inner_iterations == 500 then return result == 191
        if inner_iterations == 750 then return result == 50
        if inner_iterations == 1 then return result == 128

        print(f"No verification result for $inner_iterations found")
        print(f"Result is: $result")
        false

    private mandelbrot(*self, size: int) -> int
        var sum = 0
        var byte_acc = 0
        var bit_num = 0
        var y = 0

        while y < size
            val ci = 2.0 * real(y) / real(size) - 1.0
            var x = 0

            while x < size
                var zrzr = 0.0
                var zi = 0.0
                var zizi = 0.0
                val cr = 2.0 * real(x) / real(size) - 1.5
                var z = 0
                var not_done = true
                var escape = 0

                while not_done && z < 50
                    val zr = zrzr - zizi + cr
                    zi = 2.0 * zr * zi + ci

                    // preserve recalculation
                    zrzr = zr * zr
                    zizi = zi * zi

                    if zrzr + zizi > 4.0
                        not_done = false
                        escape = 1

                    z += 1

                byte_acc = (byte_acc << 1) + escape
                bit_num += 1

                // Code is very similar for these cases, but using separate blocks ensures we skip the
                // shifting when it's unnecessary, which is most cases.
                if bit_num == 8
                    sum ^= byte_acc
                    byte_acc = 0
                    bit_num = 0
                else if x == size - 1
                    byte_acc <<= 8 - bit_num
                    sum ^= byte_acc
                    byte_acc = 0
                    bit_num = 0

                x += 1

            y += 1

        sum
end Mandelbrot

impl Benchmark for Mandelbrot
    type Result = bool

    benchmark(*self) -> bool = panic("Should never be reached")

    verify_result(*self, result: bool) -> bool = panic("Should never be reached")

    override inner_benchmark_loop(*self, inner_iterations: int) -> bool =
        self.verify_mandelbrot(self.mandelbrot(inner_iterations), inner_iterations)
