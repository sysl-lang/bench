@no_fuse

struct TowersDisk
    size: int
    next: Option[&TowersDisk]
end TowersDisk

struct Towers
    piles: [3]Option[&TowersDisk]
    moves_done: int

    private push_disk(*self, disk: &TowersDisk, pile: int)
        val top = self.piles[pile]

        top match
            Some(t) ->
                if disk.size >= t.size then panic("Cannot put a big disk on a smaller one")
            None -> ()

        disk.next = top
        self.piles[pile] = Some(disk)

    private pop_disk_from(*self, pile: int) -> &TowersDisk
        val top = self.piles[pile] match
            Some(t) -> t
            None -> panic("Attempting to remove a disk from an empty pile")

        self.piles[pile] = top.next
        top.next = None
        top

    private move_top_disk(*self, from_pile: int, to_pile: int)
        self.push_disk(self.pop_disk_from(from_pile), to_pile)
        self.moves_done += 1

    private build_tower_at(*self, pile: int, disks: int)
        for var i = disks; i >= 0; i -= 1
            self.push_disk(TowersDisk(i, None), pile)

    private move_disks(*self, disks: int, from_pile: int, to_pile: int)
        if disks == 1
            self.move_top_disk(from_pile, to_pile)
        else
            val other_pile = 3 - from_pile - to_pile

            self.move_disks(disks - 1, from_pile, other_pile)
            self.move_top_disk(from_pile, to_pile)
            self.move_disks(disks - 1, other_pile, to_pile)
end Towers

impl Benchmark for Towers
    type Result = int

    benchmark(*self) -> int
        self.piles = [None, None, None]
        self.build_tower_at(0, 13)
        self.moves_done = 0
        self.move_disks(13, 0, 1)
        self.moves_done

    verify_result(*self, result: int) -> bool = result == 8191
