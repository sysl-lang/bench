import sysl.io.{read_all_text, stdin}
import sysl.regex.regex
import sysl.threads.scope

// Each pattern and its reverse complement, with a wildcard in one position.
val variants = [
    "agggtaaa|tttaccct",
    "[cgt]gggtaaa|tttaccc[acg]",
    "a[act]ggtaaa|tttacc[agt]t",
    "ag[act]gtaaa|tttac[agt]ct",
    "agg[act]taaa|ttta[agt]cct",
    "aggg[acg]aaa|ttt[cgt]ccct",
    "agggt[cgt]aa|tt[acg]accct",
    "agggta[cgt]a|t[acg]taccct",
    "agggtaa[cgt]|[acg]ttaccct",
]

// The IUB codes, rewritten one pattern after another.
val substitutions = [
    ("tHa[Nt]", "<4>"),
    ("aND|caN|Ha[DS]|WaS", "<3>"),
    ("a[NSt]|BY", "<2>"),
    ("<[^>]*>", "|"),
    ("\\|[^|][^|]*\\|", "-"),
]

// The sequence every thread reads, shared once: its bytes are given an atomic count as it is made.
struct Sequence
    text: string

main()
    var input = stdin()
    val text = read_all_text(&input).unwrap()

    // `.` matches a newline in an ERE, so a header line is `>` and every character up to its newline.
    val seq: &sync Sequence = Sequence(regex(">[^\n]*\n|\n").unwrap().replace_all(text, ""))
    var counts: []usize = [0; variants.len]
    val tally = counts[..]

    // As the Game's fastest programs (Rust #7, C gcc-5) divide it: the substitutions, one after
    // another, on a thread of their own, beside the nine counts, each on a thread of its own.
    val length = scope((s) ->
        val chain = s.spawn(() ->
            var out = seq.text

            for (pattern, with) in substitutions
                out = regex(pattern).unwrap().replace_all(out, with)

            out.len)

        for i in 0..<variants.len
            s.spawn(() -> tally[i] = regex(variants[i]).unwrap().find_all(seq.text).len())

        chain.join())

    for i in 0..<variants.len do print(variants[i], counts[i])

    print("")
    print(text.len)
    print(seq.text.len)
    print(length)
