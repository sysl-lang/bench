import sysl.math.min
import sysl.seq.Sequence
import sysl.text.parse_int

const line_len: usize = 60

const alu = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGG" +
            "GAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGA" +
            "CCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAAT" +
            "ACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCA" +
            "GCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGG" +
            "AGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCC" +
            "AGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"

const iub_symbols = "acgtBDHKMNRSVWY"
val iub_probabilities = [0.27, 0.12, 0.12, 0.27, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02]

const sapiens_symbols = "acgt"
val sapiens_probabilities = [0.3029549426680, 0.1979883004921, 0.1975473066391, 0.3015094502008]

struct Random
    last: int

    next(*self) -> real
        self.last = (self.last * 3877 + 29573) % 139968

        real(self.last) / 139968.0
end Random

// The sequence followed by its own first line, so every line is one slice of it.
repeat_fasta(header: string, seq: string, n: usize)
    val wrapped = seq + seq[0..<line_len]
    var at: usize = 0
    var left = n

    print(header)

    while left > 0
        val width = min(line_len, left)

        print(wrapped[at..<at + width])
        at = (at + width) % seq.len
        left -= width

// A symbol's index is how many cumulative probabilities lie below the draw. The last is never
// counted, so a draw at the top of the range still lands on the last symbol.
random_fasta(header: string, symbols: string, probabilities: []const real, n: usize, rng: *Random)
    var cumul: []real = [0.0; probabilities.len]
    var line: [61]u8
    var total = 0.0
    var left = n

    for i in 0..<probabilities.len
        total += probabilities[i]
        cumul[i] = total

    val below = cumul[0..<cumul.len - 1]

    print(header)

    while left > 0
        val width = min(line_len, left)

        for i in 0..<width
            val r = rng.next()

            line[i] = symbols.bytes[below.count_where(p -> r > p)]

        line[width] = 10
        putbytes(line[0..width])
        left -= width

main(args: []string)
    val n = usize(parse_int(args[1]).unwrap())
    var rng = Random(42)

    repeat_fasta(">ONE Homo sapiens alu", alu, n * 2)
    random_fasta(">TWO IUB ambiguity codes", iub_symbols, iub_probabilities, n * 3, &rng)
    random_fasta(">THREE Homo sapiens frequency", sapiens_symbols, sapiens_probabilities, n * 5, &rng)
