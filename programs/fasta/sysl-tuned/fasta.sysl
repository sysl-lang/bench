import sysl.math.min
import sysl.text.parse_int

const line_len: usize = 60

const alu = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGG" +
            "GAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGA" +
            "CCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAAT" +
            "ACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCA" +
            "GCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGG" +
            "AGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCC" +
            "AGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"

const iub_symbols = "acgtBDHKMNRSVWY"
val iub_probabilities = [0.27, 0.12, 0.12, 0.27, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02]

const sapiens_symbols = "acgt"
val sapiens_probabilities = [0.3029549426680, 0.1979883004921, 0.1975473066391, 0.3015094502008]

const modulus = 139968

repeat_fasta(header: string, seq: string, n: usize)
    var line: [61]u8
    var at: usize = 0
    var left = n

    print(header)

    while left > 0
        val width = min(line_len, left)

        for i in 0..<width
            line[i] = seq.bytes[at]
            at = (at + 1) % seq.len

        line[width] = 10
        putbytes(line[0..width])
        left -= width

// limits[j] is the number of generator states below which cumulative[j] is
// still at least the state's value, so comparing integers picks the same symbol
// as comparing the probabilities, without a division per byte.
limits(probabilities: []const real) -> []int
    var limits: []int = [0; probabilities.len]
    var total = 0.0

    for j in 0..<probabilities.len
        total += probabilities[j]

        var below = 0

        while below < modulus && real(below) / 139968.0 <= total do below += 1

        limits[j] = below

    limits

// The generator state is carried in and out in a local, so it stays in a register.
random_fasta(header: string, symbols: string, limits: []const int, n: usize, seed: int) -> int
    var line: [61]u8
    var state = seed
    var left = n

    print(header)

    while left > 0
        val width = min(line_len, left)

        for i in 0..<width
            state = (state * 3877 + 29573) % modulus

            var k = 0

            for j in 0..<limits.len - 1 do k += if state >= limits[j] then 1 else 0

            line[i] = symbols.bytes[k]

        line[width] = 10
        putbytes(line[0..width])
        left -= width

    state

main(args: []string)
    val n = usize(parse_int(args[1]).unwrap())

    repeat_fasta(">ONE Homo sapiens alu", alu, n * 2)

    val seed = random_fasta(">TWO IUB ambiguity codes", iub_symbols, limits(iub_probabilities), n * 3, 42)

    random_fasta(">THREE Homo sapiens frequency", sapiens_symbols, limits(sapiens_probabilities), n * 5, seed)
