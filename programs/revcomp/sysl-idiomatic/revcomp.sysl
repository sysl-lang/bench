import sysl.io.{read_all, stdin}
import sysl.math.min
import sysl.text.Search
import sysl.threads.scope

// The bases on a full line, and the line with its newline.
const width: usize = 60
const line_len: usize = 61

// complement[b] is the IUPAC complement of the base b, upper case, whatever b's case.
complements() -> [256]u8
    var table: [256]u8
    val from = "ACGTUMRWSYKVHDBN"
    val to = "TGCAAKYWSRMBDHVN"

    for i in 0..<from.len
        table[from.bytes[i]] = to.bytes[i]
        table[from.bytes[i] | 0x20] = to.bytes[i]

    table

// Where base b of a sequence sits among its lines.
at(b: usize) -> usize = b + b / width

// Writes the reverse complement of one sequence's lines, body (every line ends in a newline), into
// out, the same size. Output line l holds the bases n-1-60l down to n-60l-60 of the n, read across at
// most one of the input's newlines. The lines are dealt out in one band per processor, each band on a
// scoped thread, as the Game's fastest programs (C gcc-7, Rust) share out each sequence's lines.
reverse_complement(body: []const u8, out: []u8, complement: [256]u8)
    val lines = (body.len + line_len - 1) / line_len
    val n = body.len - lines
    val bands = cpu_count()
    val size = (lines + bands - 1) / bands

    scope((s) ->
        for band in 0..<bands
            val first = min(band * size, lines)
            val last = min(first + size, lines)

            s.spawn(() ->
                for l in first..<last
                    val o = l * line_len
                    val top = n - 1 - l * width
                    val count = min(width, n - l * width)

                    for k in 0..<count do out[o + k] = complement[body[at(top - k)]]

                    out[o + count] = u8('\n')))

main()
    var input = stdin()
    val input_bytes = read_all(&input)
    val data = input_bytes.view()
    var out: []u8 = [0; data.len]
    val complement = complements()
    var i = 0

    while i < data.len
        val start = data.index_of_byte_from(u8('\n'), i).unwrap() + 1
        val end = data.index_of_byte_from(u8('>'), start).unwrap_or(data.len)

        for j in i..<start do out[j] = data[j]

        reverse_complement(data[start..<end], out[start..<end], complement)
        i = end

    putbytes(out)
