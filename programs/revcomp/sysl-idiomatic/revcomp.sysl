import sysl.buf.{Buf, buf}
import sysl.io.{read_all, stdin}
import sysl.math.min
import sysl.slices.reverse
import sysl.text.Search

const line_len: usize = 60

// complement[b] is the IUPAC complement of the base b, upper case, whatever b's case.
complements() -> [256]u8
    var table: [256]u8
    val from = "ACGTUMRWSYKVHDBN"
    val to = "TGCAAKYWSRMBDHVN"

    for i in 0..<from.len
        table[from.bytes[i]] = to.bytes[i]
        table[from.bytes[i] | 0x20] = to.bytes[i]

    table

val complement = complements()

// Writes the reverse complement of bases to out in lines of line_len.
write_reversed(bases: []u8, out: Buf[u8])
    reverse(bases)

    for i in 0..<bases.len do bases[i] = complement[bases[i]]

    var i = 0

    while i < bases.len
        val end = min(i + line_len, bases.len)

        out.extend(bases[i..<end])
        out.push(u8('\n'))
        i = end

main()
    var input = stdin()
    val input_bytes = read_all(&input)
    val data = input_bytes.view()
    val out: Buf[u8] = buf()
    var seq: Buf[u8] = buf()
    var i = 0

    while i < data.len
        val end = data.index_of_byte_from(u8('\n'), i).unwrap_or(data.len - 1)

        if data[i] == u8('>')
            write_reversed(seq.view_mut(), out)
            seq.clear()
            out.extend(data[i..end])
        else
            seq.extend(data[i..<end])

        i = end + 1

    write_reversed(seq.view_mut(), out)
    putbytes(out.view())
