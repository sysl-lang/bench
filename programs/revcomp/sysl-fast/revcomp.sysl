import sysl.buf.{Buf, buf}
import sysl.io.stdin
import sysl.math.min
import sysl.text.Search

// A full line of bases and its newline.
const line_len: usize = 61

// complement[b] is the IUPAC complement of the base b, upper case, whatever b's case.
complements() -> [256]u8
    var table: [256]u8
    val from = "ACGTUMRWSYKVHDBN"
    val to = "TGCAAKYWSRMBDHVN"

    for i in 0..<from.len
        table[from.bytes[i]] = to.bytes[i]
        table[from.bytes[i] | 0x20] = to.bytes[i]

    table

val complement = complements()

// Swaps the complements of d[a..<a + n] and d[b - n..<b], the first run read forwards and the
// second backwards.
//
// Tuned: `@unchecked`, since both runs lie inside `d` by construction.
swap_runs(d: []u8, a: usize, b: usize, n: usize)
    @unchecked
        for k in 0..<n
            val x = d[a + k]

            d[a + k] = complement[d[b - 1 - k]]
            d[b - 1 - k] = complement[x]

// Reverse-complements one sequence's lines in place, leaving every newline where it was. d is the
// lines without their final newline. Each round swaps a run from the front with a run from the back:
// the back's newlines sit `t` bytes after a line start counted from the end, the front's 60 - t.
reverse_complement(d: []u8)
    val t = d.len % line_len
    val mid = d.len / 2
    var lo = 0
    var hi = d.len

    while lo < mid || hi > mid
        // The front run ends where the back's line does; the back then steps over its newline.
        var front = lo
        var front_end = lo + min(t, mid - lo)
        var back = hi - min(t, hi - mid)
        var back_end = hi

        lo = front_end
        hi = back - min(1, back - mid)

        // At the middle, an odd byte left over falls on the back.
        if back_end - back > front_end - front
            d[back] = complement[d[back]]
            back += 1

        swap_runs(d, front, back_end, min(front_end - front, back_end - back))

        // The front run ends at the front's newline, which it then steps over.
        front = lo
        front_end = lo + min(line_len - 1 - t, mid - lo)
        back = hi - min(line_len - 1 - t, hi - mid)
        back_end = hi

        lo = front_end + min(1, mid - front_end)
        hi = back

        // At the middle, an odd byte left over falls on the front.
        if front_end - front > back_end - back
            front_end -= 1
            d[front_end] = complement[d[front_end]]

        swap_runs(d, front, back_end, min(front_end - front, back_end - back))

extern malloc(n: usize) -> *u8
extern realloc(p: *u8, n: usize) -> *u8
extern read(fd: i32, into: *u8, n: usize) -> isize

main()
    // Tuned: the input goes into storage grown with `realloc`, which hands large blocks on by
    // remapping their pages, where `Buf`'s growth allocates afresh and copies every byte across
    // (FINDINGS 1).
    var cap: usize = 1 << 20
    var len: usize = 0
    var storage = malloc(cap)

    loop
        if cap - len < 1 << 16
            cap *= 2
            storage = realloc(storage, cap)

        val got = read(0, &storage[len], cap - len)

        if got <= 0 then break

        len += usize(got)

    val bytes = storage[0..<len]
    var i = 0

    while i < bytes.len
        val start = bytes.index_of_byte_from(u8('\n'), i).unwrap() + 1
        val end = bytes.index_of_byte_from(u8('>'), start).unwrap_or(bytes.len)

        reverse_complement(bytes[start..<end - 1])
        i = end

    putbytes(bytes)
