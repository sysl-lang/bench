import sysl.text.parse_int

// The denominator of A[i][j], as a double. It stays scalar integer
// arithmetic: a 64-bit lane multiply has no vector instruction, so a
// `<2>usize` form moves every lane out to a general register and back.
a(i: usize, j: usize) -> real = real((i + j) * (i + j + 1) / 2 + i + 1)

// Two columns per step, as in the Rust program: the two denominators
// meet the two vector elements in one two-lane divide.
times(v: []const real, out: []real)
    for i in 0..<out.len
        var sum: <2>real = 0

        for j in 0..<v.len / 2
            val top: <2>real = v.load(2 * j)
            sum += top / [a(i, 2 * j), a(i, 2 * j + 1)]

        out[i] = sum.sum()

times_transpose(v: []const real, out: []real)
    for i in 0..<out.len
        var sum: <2>real = 0

        for j in 0..<v.len / 2
            val top: <2>real = v.load(2 * j)
            sum += top / [a(2 * j, i), a(2 * j + 1, i)]

        out[i] = sum.sum()

times_a_transpose_a(v: []const real, out: []real, tmp: []real)
    times(v, tmp)
    times_transpose(tmp, out)

main(args: []string)
    val n = usize(parse_int(args[1]).unwrap())
    var u: []real = [1.0; n]
    var v: []real = [0.0; n]
    var tmp: []real = [0.0; n]

    for _ in 0..<10
        times_a_transpose_a(u, v, tmp)
        times_a_transpose_a(v, u, tmp)

    var vbv = 0.0
    var vv = 0.0

    for i in 0..<n
        vbv += u[i] * v[i]
        vv += v[i] * v[i]

    print(f"${(vbv / vv).sqrt()}%.9f")
