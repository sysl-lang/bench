import sysl.text.parse_int

// Two columns per step, as in the Rust program: both columns' integer
// denominators are computed together and converted to two doubles.
a2(ii: <2>usize, jj: <2>usize) -> <2>real
    val s = ii + jj

    <2>real((s * (s + 1) >> 1) + ii + 1)

times(v: []const real, out: []real)
    for i in 0..<out.len
        var sum: <2>real = 0

        for j in 0..<v.len / 2
            val top: <2>real = v.load(2 * j)
            sum += top / a2([i, i], [2 * j, 2 * j + 1])

        out[i] = sum.sum()

times_transpose(v: []const real, out: []real)
    for i in 0..<out.len
        var sum: <2>real = 0

        for j in 0..<v.len / 2
            val top: <2>real = v.load(2 * j)
            sum += top / a2([2 * j, 2 * j + 1], [i, i])

        out[i] = sum.sum()

times_a_transpose_a(v: []const real, out: []real, tmp: []real)
    times(v, tmp)
    times_transpose(tmp, out)

main(args: []string)
    val n = usize(parse_int(args[1]).unwrap())
    var u: []real = [1.0; n]
    var v: []real = [0.0; n]
    var tmp: []real = [0.0; n]

    for _ in 0..<10
        times_a_transpose_a(u, v, tmp)
        times_a_transpose_a(v, u, tmp)

    var vbv = 0.0
    var vv = 0.0

    for i in 0..<n
        vbv += u[i] * v[i]
        vv += v[i] * v[i]

    print(f"${(vbv / vv).sqrt()}%.9f")
