import sysl.math.min
import sysl.text.parse_int
import sysl.threads.scope

a(i: usize, j: usize) -> real = 1.0 / real((i + j) * (i + j + 1) / 2 + i + 1)

// out = A·v, or Aᵀ·v. The rows are dealt out in one band per processor, each band on a scoped thread
// of its own, as the Game's OpenMP and Rust programs share out each product's rows.
times(v: []const real, out: []real, transpose: bool)
    val bands = cpu_count()
    val size = (out.len + bands - 1) / bands

    scope((s) ->
        for b in 0..<bands
            val lo = min(b * size, out.len)
            val rows = out[lo..<min(lo + size, out.len)]

            s.spawn(() ->
                for r in 0..<rows.len
                    val i = lo + r
                    var sum = 0.0

                    for j in 0..<v.len do sum += (if transpose then a(j, i) else a(i, j)) * v[j]

                    rows[r] = sum))

times_a_transpose_a(v: []const real, out: []real, tmp: []real)
    times(v, tmp, false)
    times(tmp, out, true)

main(args: []string)
    val n = usize(parse_int(args[1]).unwrap())
    var u: []real = [1.0; n]
    var v: []real = [0.0; n]
    var tmp: []real = [0.0; n]

    for _ in 0..<10
        times_a_transpose_a(u, v, tmp)
        times_a_transpose_a(v, u, tmp)

    var vbv = 0.0
    var vv = 0.0

    for i in 0..<n
        vbv += u[i] * v[i]
        vv += v[i] * v[i]

    print(f"${(vbv / vv).sqrt()}%.9f")
