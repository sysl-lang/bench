import sysl.math.max
import sysl.text.parse_int

enum Tree
    Leaf
    Node(left: &Tree, right: &Tree)

make(depth: int) -> &Tree
    if depth == 0 then Leaf
    else Node(make(depth - 1), make(depth - 1))

check(t: &Tree) -> int
    *t match
        Leaf -> 1
        Node(l, r) -> 1 + check(l) + check(r)

main(args: []string)
    val n = parse_int(args[1]).unwrap()
    val min_depth = 4
    val max_depth = max(min_depth + 2, n)

    print(f"stretch tree of depth ${max_depth + 1}\t check: ${check(make(max_depth + 1))}")

    val long_lived = make(max_depth)

    for var depth = min_depth; depth <= max_depth; depth += 2
        val iterations = 1 << (max_depth - depth + min_depth)
        var total = 0

        for _ in 0..<iterations do total += check(make(depth))

        print(f"$iterations\t trees of depth $depth\t check: $total")

    print(f"long lived tree of depth $max_depth\t check: ${check(long_lived)}")
