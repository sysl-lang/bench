import sysl.cpu_count
import sysl.math.{max, min}
import sysl.text.parse_int
import sysl.threads.scope

enum Tree
    Leaf
    Node(left: &Tree, right: &Tree)

make(depth: int) -> &Tree
    if depth == 0 then Leaf
    else Node(make(depth - 1), make(depth - 1))

check(t: &Tree) -> int
    *t match
        Leaf -> 1
        Node(l, r) -> 1 + check(l) + check(r)

// The trees of one depth are shared out among one thread per processor, as the Game's Rust and C++
// programs share them: thread p builds and checks its own stretch of the iterations, and the depth's
// total is the sum of the threads' once all of them have finished.
total(depth: int, iterations: int) -> int
    val parts = min(iterations, int(cpu_count()))
    var checks: []int = [0; parts]

    scope((s) ->
        for p in 0..<parts
            s.spawn(() ->
                for _ in p * iterations / parts..<(p + 1) * iterations / parts do checks[p] += check(make(depth))))

    var sum = 0

    for c in checks do sum += c

    sum

main(args: []string)
    val n = parse_int(args[1]).unwrap()
    val min_depth = 4
    val max_depth = max(min_depth + 2, n)

    print(f"stretch tree of depth ${max_depth + 1}\t check: ${check(make(max_depth + 1))}")

    val long_lived = make(max_depth)

    for var depth = min_depth; depth <= max_depth; depth += 2
        val iterations = 1 << (max_depth - depth + min_depth)

        print(f"$iterations\t trees of depth $depth\t check: ${total(depth, iterations)}")

    print(f"long lived tree of depth $max_depth\t check: ${check(long_lived)}")
