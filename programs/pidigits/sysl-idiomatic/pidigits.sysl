import sh.sysl.gmp.Int
import sysl.text.{parse_int, str_builder}

// Gibbons' unbounded spigot in Mr Ledrug's form, the Benchmarks Game C program's, over GMP through
// the sysl-lang/gmp package, written with its operators: each term widens the fraction, and a digit
// is emitted once (3·num + acc)/den and (4·num + acc)/den agree. One thread, as every one of the
// Game's fastest pidigits programs: each step needs the one before it.
main(args: []string)
    val n = parse_int(args[1]).unwrap()
    var acc = Int.of(0)
    var den = Int.of(1)
    var num = Int.of(1)
    var line = str_builder()
    var i = 0
    var k: long = 0

    while i < n
        k += 1

        val k2 = k * 2 + 1

        acc = (acc + num * 2) * k2
        den = den * k2
        num = num * k

        if num > acc then continue

        val d = (num * 3 + acc) / den

        if d != (num * 4 + acc) / den then continue

        val digit = d.to_long().unwrap()

        line.push_int(digit)
        i += 1

        if i % 10 == 0
            print(s"${line.finish()}\t:$i")
            line = str_builder()

        acc = (acc - den * digit) * 10
        num = num * 10
    end while

    if i % 10 != 0
        for _ in i % 10..<10 do line.push(" ")
        print(s"${line.finish()}\t:$i")
