import sh.sysl.gmp.Int
import sysl.text.{parse_int, str_builder}

// (num·nth + acc) / den, truncated, into tmp.
extract(num: Int, acc: Int, den: Int, tmp: Int, nth: long) -> ulong
    tmp.set_mul(num, nth)
    tmp.add_assign(acc)
    tmp.div_assign(den)
    tmp.low_ulong()

// Gibbons' unbounded spigot in Mr Ledrug's form over GMP through the sysl-lang/gmp package, written
// in place as the Game's fastest C and C++ entries write it: no integer is allocated in the loop, and
// two divisions per candidate digit (one `mpz_tdiv_qr` whose remainder decides the second digit
// measured slower in C; SOURCES.md). One thread, as every one of the Game's fastest pidigits programs:
// each step needs the one before it.
main(args: []string)
    val n = parse_int(args[1]).unwrap()
    val acc = Int.of(0)
    val den = Int.of(1)
    val num = Int.of(1)
    val tmp = Int.of(0)
    var line = str_builder()
    var i = 0
    var k: long = 0

    while i < n
        k += 1

        val k2 = k * 2 + 1

        acc.add_mul(num, 2)
        acc.mul_assign(k2)
        den.mul_assign(k2)
        num.mul_assign(k)

        if num > acc then continue

        val d = extract(num, acc, den, tmp, 3)

        if d != extract(num, acc, den, tmp, 4) then continue

        line.push_uint(d)
        i += 1

        if i % 10 == 0
            print(s"${line.finish()}\t:$i")
            line = str_builder()

        acc.sub_mul(den, long(d))
        acc.mul_assign(10)
        num.mul_assign(10)
    end while

    if i % 10 != 0
        for _ in i % 10..<10 do line.push(" ")
        print(s"${line.finish()}\t:$i")
