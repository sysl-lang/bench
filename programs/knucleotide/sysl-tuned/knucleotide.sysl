import sysl.buf.{Buf, buf}
import sysl.container.{Map, map_with_capacity}
import sysl.math.min
import sysl.slices.sort_by
import sysl.text.{Search, from_utf8_lossy}

extern malloc(n: usize) -> *u8
extern realloc(p: *u8, n: usize) -> *u8
extern free(p: *u8)
extern read(fd: i32, into: *u8, n: usize) -> isize

const letters = "ACGT"

struct Entry
    key: u64
    count: int
end Entry

// A k-mer's 2k-bit code as a map key.
//
// Tuned: a key type of the program's own whose hash is one multiply by the 64-bit golden ratio,
// Rust's k-mer hasher, where the library's integer hash mixes expensively and spreads dense keys
// badly (FINDINGS 3).
struct Kmer derives Eq
    code: u64

impl Hash for Kmer
    hash(self) -> u64 = self.code *% 0x9E3779B97F4A7C15

// A base's code, in A C G T order, whatever its case.
code_of(base: u8) -> u8
    base & 0xDF match
        u8('A') -> 0
        u8('C') -> 1
        u8('G') -> 2
        _ -> 3

// The bases of the THREE section as codes 0..3, in A C G T order.
//
//
// Tuned: stdin is read straight into storage grown with `realloc` (`read_all` pushes byte by byte,
// and `Buf`'s growth copies every byte to fresh storage: FINDINGS 1), and the codes are written by
// index into a preallocated array in place of a `Buf.push` per base.
read_sequence() -> []u8
    var cap: usize = 1 << 20
    var len: usize = 0
    var storage = malloc(cap)

    loop
        if cap - len < 1 << 16
            cap *= 2
            storage = realloc(storage, cap)

        val got = read(0, &storage[len], cap - len)

        if got <= 0 then break

        len += usize(got)

    val bytes = storage[0..<len]
    var i = 0

    loop
        val line = bytes.index_of_byte_from(u8('>'), i).unwrap() + 1

        i = bytes.index_of_byte_from(u8('\n'), line).unwrap() + 1

        if bytes[line] == u8('T') && bytes[line + 1] == u8('H') then break

    var seq: []u8 = [0; bytes.len - i]
    var n: usize = 0

    @unchecked
        while i < bytes.len && bytes[i] != u8('>')
            if bytes[i] != u8('\n')
                seq[n] = code_of(bytes[i])
                n += 1

            i += 1

    free(storage)
    seq[0..<n]

// Tuned: the map is sized up front for as many keys as k can make, up to 2^20, so it rehashes
// little or not at all while counting. A larger cap measured slower (more memory to touch).
count_kmers(seq: []const u8, k: usize) -> Map[Kmer, int]
    val counts: Map[Kmer, int] = map_with_capacity(min(usize(1) << (2 * k), 1 << 20))
    val mask = (u64(1) << (2 * k)) - 1
    var key: u64 = 0

    @unchecked
        for i in 0..<seq.len
            key = (key << 2 | u64(seq[i])) & mask

            if i + 1 >= k then counts.upsert(Kmer(key), 0, _ + 1)

    counts

name_of(key: u64, k: usize) -> string
    var chars: Buf[u8] = buf()

    for i in 0..<k
        chars.push(letters.bytes[usize(key >> (2 * (k - 1 - i)) & 3)])

    from_utf8_lossy(chars.view())

print_frequencies(seq: []const u8, k: usize)
    val counts = count_kmers(seq, k)
    var entries: Buf[Entry] = buf()
    val total = seq.len - k + 1

    for (key, count) in counts do entries.push(Entry(key.code, count))

    sort_by(entries.view_mut(), (a, b) -> a.count > b.count || a.count == b.count && name_of(a.key, k) < name_of(b.key, k))

    for e in entries.view()
        print(f"${name_of(e.key, k)} ${100.0 * real(e.count) / real(total)}%.3f")

    print("")

print_count(seq: []const u8, pattern: string)
    var key: u64 = 0

    for b in pattern.bytes
        key = key << 2 | u64(code_of(b))

    print(f"${count_kmers(seq, pattern.len).get_or(Kmer(key), 0)}\t$pattern")

main()
    val seq = read_sequence()

    print_frequencies(seq, 1)
    print_frequencies(seq, 2)

    for pattern in ["GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT"]
        print_count(seq, pattern)
