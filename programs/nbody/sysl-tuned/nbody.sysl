import sysl.text.parse_int

// The library's sqrt is an out-of-line call; the intrinsic is one instruction.
extern "llvm.sqrt" sqrt(x: real) -> real

const pi = 3.141592653589793
const solar_mass = 4.0 * pi * pi
const days_per_year = 365.24

struct Body
    x: real
    y: real
    z: real
    vx: real
    vy: real
    vz: real
    mass: real
end Body

sun() -> Body = Body(0, 0, 0, 0, 0, 0, solar_mass)

planet(x: real, y: real, z: real, vx: real, vy: real, vz: real, mass: real) -> Body =
    Body(x, y, z, vx * days_per_year, vy * days_per_year, vz * days_per_year, mass * solar_mass)

energy(bodies: []const Body) -> real
    var e = 0.0

    for i in 0..<bodies.len
        val b = bodies[i]

        e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)

        for j in i + 1..<bodies.len
            val dx = b.x - bodies[j].x
            val dy = b.y - bodies[j].y
            val dz = b.z - bodies[j].z

            e -= b.mass * bodies[j].mass / sqrt(dx * dx + dy * dy + dz * dz)

    e

advance(bodies: []Body, dt: real)
    for i in 0..<bodies.len
        val xi = bodies[i].x
        val yi = bodies[i].y
        val zi = bodies[i].z
        val mi = bodies[i].mass
        var vxi = bodies[i].vx
        var vyi = bodies[i].vy
        var vzi = bodies[i].vz

        for j in i + 1..<bodies.len
            val dx = xi - bodies[j].x
            val dy = yi - bodies[j].y
            val dz = zi - bodies[j].z
            val d2 = dx * dx + dy * dy + dz * dz
            val mag = dt / (d2 * sqrt(d2))
            val mj = bodies[j].mass * mag

            vxi -= dx * mj
            vyi -= dy * mj
            vzi -= dz * mj
            bodies[j].vx += dx * mi * mag
            bodies[j].vy += dy * mi * mag
            bodies[j].vz += dz * mi * mag

        bodies[i].vx = vxi
        bodies[i].vy = vyi
        bodies[i].vz = vzi

    for i in 0..<bodies.len
        bodies[i].x += dt * bodies[i].vx
        bodies[i].y += dt * bodies[i].vy
        bodies[i].z += dt * bodies[i].vz

offset_momentum(bodies: []Body)
    var px = 0.0
    var py = 0.0
    var pz = 0.0

    for i in 0..<bodies.len
        px += bodies[i].vx * bodies[i].mass
        py += bodies[i].vy * bodies[i].mass
        pz += bodies[i].vz * bodies[i].mass

    bodies[0].vx = -px / solar_mass
    bodies[0].vy = -py / solar_mass
    bodies[0].vz = -pz / solar_mass

main(args: []string)
    val n = parse_int(args[1]).unwrap()

    var bodies = [
        sun(),
        planet(4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01,
               1.66007664274403694e-03, 7.69901118419740425e-03, -6.90460016972063023e-05,
               9.54791938424326609e-04),
        planet(8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01,
               -2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05,
               2.85885980666130812e-04),
        planet(1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01,
               2.96460137564761618e-03, 2.37847173959480950e-03, -2.96589568540237556e-05,
               4.36624404335156298e-05),
        planet(1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01,
               2.68067772490389322e-03, 1.62824170038242295e-03, -9.51592254519715870e-05,
               5.15138902046611451e-05)
    ]

    offset_momentum(bodies)
    print(f"${energy(bodies)}%.9f")

    for _ in 0..<n do advance(bodies, 0.01)

    print(f"${energy(bodies)}%.9f")
