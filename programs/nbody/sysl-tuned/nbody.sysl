import sysl.text.parse_int

const pi = 3.141592653589793
const solar_mass = 4.0 * pi * pi
const days_per_year = 365.24

struct Body
    pos: <3>real
    vel: <3>real
    mass: real

sun() -> Body = Body(0, 0, solar_mass)

planet(pos: <3>real, vel: <3>real, mass: real) -> Body =
    Body(pos, vel * days_per_year, mass * solar_mass)

energy(bodies: []const Body) -> real
    var e = 0.0

    for i in 0..<bodies.len
        val b = bodies[i]

        e += 0.5 * b.mass * (b.vel * b.vel).sum()

        for j in i + 1..<bodies.len
            val d = b.pos - bodies[j].pos

            e -= b.mass * bodies[j].mass / (d * d).sum().sqrt()

    e

// One thread, as every one of the Game's fastest nbody programs (C gcc-9, C++ g++-0, Rust-9): a step
// needs the positions the step before it wrote, and five bodies are too little work to share out.
//
// Tuned: the form of the Game's fastest C (`nbody.gcc-9`). A step takes the ten pairwise
// differences and squared distances into arrays, then the ten magnitudes two at a time in vector
// lanes (five square roots and five divides where there were ten of each), then the velocity
// updates. gcc-9 replaces the square root and divide by a single-precision reciprocal square root
// estimate refined in double; sysl has no estimate instruction to name, and AArch64's (`frsqrte`,
// about 8 bits) needs a third refinement where x86's needs two, so the exact square root stays.
// `@unchecked`, since every index is one of the ten pairs.
advance(bodies: []Body, dt: real)
    var d: [10]<3>real
    var d2: [10]real
    var mag: [10]real

    @unchecked
        var k = 0

        for i in 0..<bodies.len
            for j in i + 1..<bodies.len
                d[k] = bodies[i].pos - bodies[j].pos
                d2[k] = (d[k] * d[k]).sum()
                k += 1

        for var p = 0; p < 10; p += 2
            val s: <2>real = d2.load(p)

            mag.store(p, dt / (s * s.sqrt()))

        k = 0

        for i in 0..<bodies.len
            for j in i + 1..<bodies.len
                bodies[i].vel -= d[k] * bodies[j].mass * mag[k]
                bodies[j].vel += d[k] * bodies[i].mass * mag[k]
                k += 1

        for i in 0..<bodies.len do bodies[i].pos += dt * bodies[i].vel

offset_momentum(bodies: []Body)
    var p: <3>real = 0

    for b in bodies do p += b.vel * b.mass

    bodies[0].vel = -p / solar_mass

main(args: []string)
    val n = parse_int(args[1]).unwrap()

    var bodies = [
        sun(),
        planet([4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01],
               [1.66007664274403694e-03, 7.69901118419740425e-03, -6.90460016972063023e-05],
               9.54791938424326609e-04),
        planet([8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01],
               [-2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05],
               2.85885980666130812e-04),
        planet([1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01],
               [2.96460137564761618e-03, 2.37847173959480950e-03, -2.96589568540237556e-05],
               4.36624404335156298e-05),
        planet([1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01],
               [2.68067772490389322e-03, 1.62824170038242295e-03, -9.51592254519715870e-05],
               5.15138902046611451e-05)
    ]

    offset_momentum(bodies)
    print(f"${energy(bodies)}%.9f")

    for _ in 0..<n do advance(bodies, 0.01)

    print(f"${energy(bodies)}%.9f")
